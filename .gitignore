# Per-operator config — copy from compose/appsettings.example.json,
# fill in real secrets, never commit.
compose/appsettings.json

# Per-operator env — contains XOR_KEY + ADMIN_PASSWORD after first
# `make wizard` / `make platform-up`. Copy from compose/.env.example.
compose/.env

# Local checkout of the custom GZCTF source. Keep this as a separate
# repo or submodule; the platform template only needs the path at build time.
gzctf/

# Local ACME account/certificate cache.
compose/letsencrypt/

# Generated by the challenge proxy watcher at runtime.
compose/challenge-proxy/dynamic/routes.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs / temp
*.log
*.tmp
